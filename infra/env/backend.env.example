# Reference for standalone backend deployments; Compose reads the root .env.
APP_ENV=production
# Generate a unique random value with at least 32 characters.
APP_SECRET_KEY=
DATABASE_URL=
TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://127.0.0.1:18050,http://localhost:18050
AUTO_SEED=false
# Optional first-start administrator. Supply both; at least 16 password characters.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_DIR=/absolute/path/to/public-checkout/runtime/uploads
RAW_PATH_BROWSE_ROOTS=/absolute/path/to/public-checkout/runtime/uploads,/raw_test
WORKFLOW_PIPELINE_ROOT=/absolute/path/to/public-checkout/workflows/nextflow4ms-dial-msdial5-clean
# Development only: APP_ENV=dev and AUTO_SEED=true explicitly enable demo users.
# A development bypass additionally requires an explicit TESTING_GOD_TOKEN value.
