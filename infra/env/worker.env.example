# Reference for standalone worker deployments; Compose reads the root .env.
DATABASE_URL=
APP_SECRET_KEY=
WORKER_POLL_INTERVAL_SECONDS=5
NEXTFLOW_MODE=external
WORKFLOW_EXECUTION_PROFILE=local_docker
WORKFLOW_PIPELINE_ROOT=/absolute/path/to/public-checkout/workflows/nextflow4ms-dial-msdial5-clean
WORKFLOW_RUNS_ROOT=/absolute/path/to/public-checkout/runtime/workflow-runs
WORKFLOW_LOCAL_RUNS_ROOT=/absolute/path/to/public-checkout/runtime/workflow-runs
WORKFLOW_NEXTFLOW_BIN=nextflow
WORKFLOW_NEXTFLOW_DEFAULT_PROFILE=docker
WORKFLOW_LOCAL_MAX_MEMORY_GB=6
WORKFLOW_LOCAL_PEAK_MEMORY_GB=6
WORKFLOW_LOCAL_PREPARE_MEMORY_GB=4
WORKFLOW_LOCAL_DEFAULT_CPUS=1
WORKFLOW_LOCAL_PEAK_CPUS=1
WORKFLOW_NEXTFLOW_POLL_SECONDS=2
WORKFLOW_NEXTFLOW_TIMEOUT_SECONDS=0
# SIRIUS must use a separate runtime/sirius-home, never your personal home.
