FROM python:3.12-slim

LABEL org.opencontainers.image.title="MetaboLens MS-DIAL stats adapter"
LABEL org.opencontainers.image.description="Small Python runtime for adapting MS-DIAL .mdalign files to the MetaboLens stats table contract."

WORKDIR /opt/metabolens

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

COPY adapters/mdalign_to_stats_txt.py /opt/metabolens/adapters/mdalign_to_stats_txt.py
RUN chmod +x /opt/metabolens/adapters/mdalign_to_stats_txt.py
