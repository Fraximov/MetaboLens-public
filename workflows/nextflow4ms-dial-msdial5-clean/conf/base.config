// Shared baseline defaults for `main_msdial5.nf`.
// MetaboLens app launches use this file through `nextflow.config` for both
// local Docker and EMBL SLURM targets. Per-job input paths, library paths,
// container overrides, and scientific switches are still passed by the worker
// as CLI params and recorded in `contract/params.json`.
params
{
    input_dir = null // The worker supplies registered acquisition copies.
    ref = null
    msdial_config = null
    
    ms1_library = "libraries/ms1.txt"
    ms2_library = "libraries/ms2.msp"

    max_cpus = 5 // Maximum number of allocated CPU
    max_memory = 9.GB // Maximum number of allocated memory
    max_time = 24.h // Maximum execution time
}

process 
{
    withName: peak_detection_msdial5
    {
        container = params.msdial5_container_image
        time =  '1800m'
        cpus = 2
        memory = '9 GB'
    }
    withName: prepare_msdial5_input
    {
        container = params.thermorawfileparser_image
        time =  '1800m'
        cpus = 1
        memory = '4 GB'
    }
    withName: adapt_mdalign_to_stats_txt
    {
        time = '120m'
        cpus = 1
        memory = '4 GB'
    }
    withName: build_rt_correction_plan
    {
        time = '120m'
        cpus = 1
        memory = '4 GB'
    }
    withName: rewrite_mzml_retention_times
    {
        time = '120m'
        cpus = 1
        memory = '4 GB'
    }
    withName: R_PARSE_MSDIAL
    {
        time = '120m'
        cpus = 1
        memory = '4 GB'
    }
    withName: R_PREPROCESS
    {
        time = '240m'
        cpus = 2
        memory = '9 GB'
    }
    withName: R_NORMALIZE
    {
        time = '180m'
        cpus = 2
        memory = '6 GB'
    }
    withName: R_QC_REPORT
    {
        time = '180m'
        cpus = 2
        memory = '6 GB'
    }
    withName: R_STATISTICS
    {
        time = '180m'
        cpus = 2
        memory = '6 GB'
    }
    withName: R_LIPID_SUMMARY
    {
        time = '180m'
        cpus = 2
        memory = '6 GB'
    }
    withName: R_FINAL_REPORT
    {
        time = '180m'
        cpus = 2
        memory = '6 GB'
    }
}
