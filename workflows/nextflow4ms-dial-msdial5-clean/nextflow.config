    A Nextflow-based reproducible pipeline for untargeted metabolomics data analysis
    Description  : This file in the configuration of nextflow4ms-dial, including resource allocation and parameters information
    Author       : Xinsong Du
    Creation Date: 11/01/2022
    License      : MIT License
          
    This script is free software: you can redistribute it and/or modify
    it under the terms of the MIT License as published by
    the Free Software Foundation, either version 3 of the License, or
    (at your option) any later version.
    
    This script is distributed in the hope that it will be useful,
    but WITHOUT ANY WARRANTY; without even the implied warranty of
    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
    MIT License for more details.
    
    You should have received a copy of the MIT License
    along with this script.  If not, see <https://opensource.org/licenses/MIT>.
    
    For any bugs or problems found, please contact us at
    - xinsongdu@ufl.edu (or xinsongdu@gmail.com), djlemas@ufl.edu
*/

manifest {
  name = 'nextflow4ms-dial'
  author = 'Xinsong Du, Dominick Lemas'
  homePage = 'https://github.com/Nextflow4Metabolomics/nextflow4ms-dial'
  description = 'A Nextflow-based reproducible pipeline for untargeted metabolomics data analysis'
  mainScript = 'main_metabolensr.nf'
  nextflowVersion = '>=25.10.0'
  version = '1.0dev'
}

workflow.onComplete = {
    // any workflow property can be used here
    println "Pipeline complete, writing success report to file ./logs/success_report.txt"
    println "Command line: $workflow.commandLine"
    new File("./logs").mkdirs()
    File file = new File("./logs/success_report.txt")
    file.write("$workflow.success")
}

workflow.onError = {
    println "Oops .. something went wrong, exit status: $workflow.exitStatus\nWriting error message to file ./logs/error.txt"
    new File("./logs").mkdirs()
    File file = new File("./logs/error.txt")
    file.write("$workflow.errorReport")
}

params
{

    // Workflow information
    name = "A Nextflow-based reproducible pipeline for untargeted metabolomics data analysis"
    input = "mzML, ABF, or Thermo RAW files"

    // Output help information
    help = null

    // output directory
    outdir = "./results"

    // outputs for dependency information
    dependencies = "dependencies.txt"
    // Application launches override these placeholders with frozen descriptor identities.
    msdial5_container_image = "metabolens-public-msdial5:unconfigured"
    thermorawfileparser_image = "quay.io/biocontainers/thermorawfileparser@sha256:2b07a010c46fdc2c0cc918344c7400aaf7b5aec93ae645d2f9cafae43b513ada"
    stats_adapter_container_image = "metabolens-public-stats-adapter:unconfigured"
    stats_pipeline_v2_container_image = "metabolens-public-statpipeline-v2:unconfigured"
    is_qc_container_image = "metabolens-public-is-qc:unconfigured"
    workflow_stage = "full"
    apply_rt_correction = false
    is_library = "libraries/internal-standards.txt"
    is_qc_mz_tolerance_da = 0.01
    is_qc_rt_tolerance_min = 0.5
    is_qc_min_peak_height = 1000
    is_qc_min_sample_pass_fraction = 0.8
    is_qc_min_target_pass_fraction = 0.8
    is_qc_max_qc_cv_percent = 30
    stats_factor_column = "group_label"
    run_id = ""
    params_json = ""
    analysis_mode = "full"
    output_prefix = "metabolens"
    keep_unknowns = false
    remove_blank_features = true
    blank_filter_ratio = 5
    filter_by_cv = true
    qc_cv_threshold = 30
    imputation_method = "missForest"
    normalization_methods = "Raw,TIC,BMIS"
    selected_normalization_method = ""
    run_stats = true
    contrasts = ""
    test_method = "t.test"
    p_adjust_method = "fdr"
    run_lipid_module = true
    report_format = "pdf"

    // Optional SIRIUS annotation module.
    enable_sirius = false
    sirius_container_image = "metabolens-public-sirius:unconfigured"
    sirius_container_options = ""
    sirius_workspace = ""
    sirius_annotation_mode = "formulas"
    sirius_structure_db = "ALL"
    sirius_ms2_tolerance = 5
    sirius_ms1_tolerance = 2
    sirius_structure_expansive_search = "OFF"
    sirius_recompute = false

    // authors' profiles
    config_profile_description = false
    config_profile_contact = false
    config_profile_url = false
    email = false
    email_on_fail = false

    // nf-core variables
    tracedir = "${params.outdir}/pipeline_info"

}

// Keep the historical --outdir contract while using Nextflow 25.10 workflow outputs.
outputDir = params.outdir
workflow.output.mode = 'copy'

timeline {
  enabled = true
  file = "${params.tracedir}/execution_timeline.html"
  overwrite = true
}
report {
  enabled = true
  file = "${params.tracedir}/execution_report.html"
  overwrite = true
}
trace {
  enabled = true
  file = "${params.tracedir}/execution_trace.txt"
  overwrite = true
}
dag {
  enabled = true
  file = "${params.tracedir}/pipeline_dag.svg"
  overwrite = true
}

process {
  withName: prepare_msdial5_input {
    container = params.thermorawfileparser_image
    cache = 'lenient'
  }
  withName: peak_detection_msdial5 {
    container = params.msdial5_container_image
  }
  withName: adapt_mdalign_to_stats_txt {
    container = params.stats_adapter_container_image
  }
  withName: extract_is_qc {
    container = params.is_qc_container_image
  }
  withName: build_rt_correction_plan {
    container = params.is_qc_container_image
  }
  withName: rewrite_mzml_retention_times {
    container = params.is_qc_container_image
  }
  withName: /CANONICALIZE_.*/ {
    container = params.stats_adapter_container_image
  }
  withName: R_PARSE_MSDIAL {
    container = params.stats_pipeline_v2_container_image
  }
  withName: R_PREPROCESS {
    container = params.stats_pipeline_v2_container_image
  }
  withName: R_NORMALIZE {
    container = params.stats_pipeline_v2_container_image
  }
  withName: R_QC_REPORT {
    container = params.stats_pipeline_v2_container_image
  }
  withName: R_STATISTICS {
    container = params.stats_pipeline_v2_container_image
  }
  withName: R_LIPID_SUMMARY {
    container = params.stats_pipeline_v2_container_image
  }
  withName: R_FINAL_REPORT {
    container = params.stats_pipeline_v2_container_image
  }
  withName: prepare_sirius_msp {
    container = params.stats_adapter_container_image
  }
  withName: run_sirius {
    container = params.sirius_container_image
    containerOptions = params.sirius_container_options
  }
}

// Shared defaults for app-launched runs and manual profiles.
// MetaboLens passes per-job paths and scientific switches as CLI params, while
// this file owns portable task containers and baseline process resources.
includeConfig 'conf/base.config'

profiles {
  // App-used local target: selected as `Local Docker` in the Workflows page.
  docker {
    docker.enabled = true
    docker.runOptions = '-u \$(id -u):\$(id -g)'
  }
  // Site-configured SLURM target; profile name retained for the application API.
  // The MetaboLens worker submits a small driver job over SSH, then Nextflow
  // uses this profile on the cluster to submit the actual workflow tasks.
  embl_slurm {
    process.executor = 'slurm'
    singularity.enabled = true
    singularity.autoMounts = true
  }
  // Generic manual container profile; supply your own site configuration.
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.cacheDir = "./tmp/"
  }
}
